# Agent 部署配置（配合 deploy/docker-compose.agent.yml 使用）
# 复制为 deploy/.env.agent 后填写配置。

# Server gRPC 地址：必须使用带 scheme 的 URL（如 https://backup.example.com:9090 或 http://host:9090）
# 旧版 host:port 升级注意：若此前配合 BMC_SERVER_TLS=0 使用，请先改为 http://host:port；若配合 BMC_SERVER_TLS=1 使用，请改为 https://host:port
BMC_SERVER_GRPC_URL=https://backup.example.com:9090

# 首次从 Server Web UI 获取的一次性注册令牌（注册完成后建议清空并重建容器）
BMC_ENROLLMENT_TOKEN=<one-time-token>


# 可选：旧 Agent 重新安装接管时填入（配合接管令牌恢复原 Agent 身份与仓库）
# BMC_TARGET_AGENT_ID=01955f00-0000-7000-8000-000000000000
# 宿主机源目录与恢复目录挂载路径（源目录以只读挂载，恢复目录以读写挂载）
# 约定：宿主机路径 X 挂到 /backup-sources/X；计划里的源路径可直接写宿主机路径（/etc 自动映射为 /backup-sources/etc）
BMC_SOURCE_ETC=/etc
BMC_SOURCE_SRV=/srv

# 恢复目标宿主机目录（单个绝对路径，同时作为宿主机挂载源；留空时容器内使用 /backup-restore、宿主机默认挂载 ./backup-restore）
# BMC_RESTORE_ROOT=/backup-restore

# 可选：根目录覆盖（通常无需修改）
# BMC_SOURCE_ROOTS=/backup-sources,/backup-data   # 容器内备份源根目录，可多个用逗号分隔

# 可选：逻辑备份（数据库类）导出前的暂存空间守卫。
# 要求暂存目录可用空间 >= max(计划里的预估导出字节 × 1.3, 本值)，不足则直接以
# insufficient_temp_space 失败，不会产生半截 dump。默认 0 = 只按预估导出大小判断。
# BMC_SCRATCH_MIN_FREE_BYTES=0

# 可选：同一 Agent 同时执行的运行数上限，默认 2。
# BMC_AGENT_MAX_CONCURRENCY=2

# 可选：Agent 能力探测（restic/rclone/数据库客户端版本）与上报间隔，单位秒，默认 600。
# BMC_AGENT_PROBE_INTERVAL=600

# 可选覆盖：
# BMC_AGENT_IMAGE=wdjoys/backup-management-center-agent:latest
# VERSION=0.1.0
