# Agent 环境变量示例
# 使用方式：在 Agent 目标主机执行 cp deploy/.env.agent.example .env.agent，
# 然后逐项填写。注册成功后立即删除 BMC_ENROLLMENT_TOKEN。
# 本文件只包含示例值，禁止填写真实令牌或凭据后提交 Git。

# Server Agent gRPC 地址，必须是纯 host:port，不要带 https://。
# 直连 TLS 示例：backup.example.com:9090；经外部反向代理转发示例：backup.example.com:443。
BMC_SERVER_GRPC_URL=backup.example.com:9090

# 是否启用 Server/Agent gRPC TLS；直连 TLS 或经 HTTPS 反向代理均填写 1。
BMC_SERVER_TLS=1

# Server Web UI 生成的一次性注册令牌；首次注册后必须删除或清空。
BMC_ENROLLMENT_TOKEN=<一次性注册令牌>

# Agent 镜像地址；生产回滚时建议使用不可变 sha 标签。
BMC_AGENT_IMAGE=wdjoys/backup-management-center-agent:latest

# 本地构建版本号；使用远端镜像时可保持默认。
VERSION=0.1.0

# 宿主机备份源目录。Compose 会以只读方式挂载到容器对应目录。
BMC_SOURCE_ETC=/etc
BMC_SOURCE_SRV=/srv

# 宿主机路径到容器运行时路径的 JSON 映射；必须与 Compose 只读挂载逐项对应。
# 计划中填写宿主机原始路径（如 /etc、/srv），Agent 会自动转换。
BMC_SOURCE_PATH_MAPPINGS={"/etc":"/backup-sources/etc","/srv":"/backup-sources/srv"}

# 容器内允许访问的备份源根目录（逗号分隔）；不会自动创建宿主机挂载。
BMC_SOURCE_ROOTS=/backup-sources

# 宿主机恢复目录；Compose 将其读写挂载到容器恢复根目录。
BMC_RESTORE_ROOT=/var/lib/bmc-restore
BMC_RESTORE_ROOTS=/backup-restore

# Agent 身份和状态目录、restic 缓存目录（通常无需修改）。
BMC_AGENT_STATE_DIR=/var/lib/bmc-agent
BMC_RESTIC_CACHE_DIR=/var/lib/bmc-agent/.cache/restic

# 临时工作目录所需最小可用空间，单位字节；0 表示不额外限制。
BMC_SCRATCH_MIN_FREE_BYTES=0

# 同时执行的最大任务数；请按主机 CPU、内存和存储能力调整。
BMC_AGENT_MAX_CONCURRENCY=2
