# 已有部署兼容模板：继续使用 docker-compose.yml、原主密钥 Secret 和环境变量。
# 新部署请根据入口选择 docker-compose.tls.yml 或 docker-compose.proxy.yml。
BMC_PUBLIC_URL=https://backup.example.com
BMC_SERVER_IMAGE=wdjoys/backup-management-center-server:latest
VERSION=0.1.0
BMC_MASTER_KEY_FILE=./secrets/master.key
BMC_TLS_CERT_FILE=./secrets/server.crt
BMC_TLS_KEY_FILE=./secrets/server.key
BMC_TLS_MODE=auto
BMC_SERVER_BIND=0.0.0.0
BMC_SERVER_PORT=443
BMC_GRPC_BIND=0.0.0.0
BMC_GRPC_PORT=9090
BMC_DEV_INSECURE=0
