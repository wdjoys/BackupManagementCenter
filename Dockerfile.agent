# syntax=docker/dockerfile:1.7

FROM golang:1.27-bookworm AS go-build
ARG VERSION=0.1.0
ENV GOPROXY=https://goproxy.cn,direct
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -ldflags="-s -w -X backupmanagementcenter/internal/version.Version=$VERSION" -o /out/backup-center-agent ./cmd/agent

FROM debian:bookworm-slim
ARG DEBIAN_MIRROR=mirrors.aliyun.com
ARG RESTIC_VERSION=0.18.0
ARG RCLONE_VERSION=1.69.0
ARG RESTIC_BASE_URL=https://gh-proxy.com/https://github.com/restic/restic/releases/download
ARG RCLONE_BASE_URL=https://gh-proxy.com/https://github.com/rclone/rclone/releases/download
RUN sed -i "s|deb.debian.org/debian|${DEBIAN_MIRROR}/debian|g; s|security.debian.org/debian-security|${DEBIAN_MIRROR}/debian-security|g" /etc/apt/sources.list.d/debian.sources && \
    apt-get update && apt-get install -y --no-install-recommends ca-certificates curl unzip bzip2 sqlite3 mariadb-client postgresql-client && \
    rm -rf /var/lib/apt/lists/* && \
    curl -fsSL "${RESTIC_BASE_URL}/v${RESTIC_VERSION}/restic_${RESTIC_VERSION}_linux_amd64.bz2" | bunzip2 > /usr/local/bin/restic && \
    chmod 0755 /usr/local/bin/restic && \
    curl -fsSL "${RCLONE_BASE_URL}/v${RCLONE_VERSION}/rclone-v${RCLONE_VERSION}-linux-amd64.zip" -o /tmp/rclone.zip && \
    unzip -q /tmp/rclone.zip -d /tmp/rclone && \
    install -m 0755 "/tmp/rclone/rclone-v${RCLONE_VERSION}-linux-amd64/rclone" /usr/local/bin/rclone && \
    rm -rf /tmp/rclone /tmp/rclone.zip
COPY --from=go-build /out/backup-center-agent /usr/local/bin/backup-center-agent
# 固定 UID/GID 65532：compose 中 scratch tmpfs 必须显式指定属主才能匹配
# 运行用户，同时与 Server 镜像的 distroless nonroot 约定保持一致。
RUN groupadd --system --gid 65532 bmc-agent && \
    useradd --system --uid 65532 --gid bmc-agent --home-dir /var/lib/bmc-agent --create-home --shell /usr/sbin/nologin bmc-agent && \
    mkdir -p /var/lib/bmc-agent/scratch && chown -R bmc-agent:bmc-agent /var/lib/bmc-agent
USER bmc-agent:bmc-agent
VOLUME ["/var/lib/bmc-agent", "/backup-sources"]
ENTRYPOINT ["/usr/local/bin/backup-center-agent"]
