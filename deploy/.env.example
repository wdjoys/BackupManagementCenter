# Server 部署配置（配合 deploy/docker-compose.yml 使用）
# 推荐架构：由外部反向代理（Nginx/Caddy/Traefik 等）终止公网 TLS 并转发 Web/API 与 gRPC。
# 复制为 deploy/.env 后按需修改。

# 必填：BMC 对外访问的公网 HTTPS/HTTP URL（结尾不加斜杠）。
# 必须改成实际地址，不要保留示例值——占位默认值会让通知链接与 cookie 判定指向错误地址。
BMC_PUBLIC_URL=

# 可选覆盖：
# BMC_SERVER_IMAGE=wdjoys/backup-management-center-server:latest
# VERSION=0.1.0
# BMC_SERVER_BIND=127.0.0.1
# BMC_SERVER_PORT=8080
# BMC_GRPC_BIND=127.0.0.1
# BMC_GRPC_PORT=9090

# 可选：已通过真实隔离实例验证的数据库恢复类型（逗号分隔，默认空=全部禁用）。
# 可选值：postgresql、mysql、mongodb、sqlite。未列出的类型返回 503，
# 需先在真实实例上验证预备份与回滚后再逐项启用。
BMC_DATABASE_RESTORE_KINDS=

# 可选：运行历史（runs/日志/审计事件）保留天数，0（默认）表示永久保留。
# BMC_HISTORY_RETENTION_DAYS=0

# 可选：Prometheus 指标监听地址。默认 127.0.0.1:9100（仅容器本地，宿主机采集不到）；
# 需要采集时设为 :9100 并在 compose 中发布 9100 端口。
# BMC_METRICS_ADDR=127.0.0.1:9100
