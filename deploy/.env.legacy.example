# 已有部署兼容配置（配合 deploy/docker-compose.legacy.yml 使用）
# 继续使用原主密钥、TLS 证书 Secret 和环境变量。
# 启动命令：docker compose --env-file deploy/.env.legacy -f deploy/docker-compose.legacy.yml up -d --build

# 必填：BMC 对外访问的公网 HTTPS/HTTP URL（结尾不加斜杠），必须改成实际地址。
BMC_PUBLIC_URL=
BMC_SERVER_IMAGE=wdjoys/backup-management-center-server:latest
VERSION=0.1.0
# 以下三项是宿主机上的文件路径（Compose Secret 的来源）；容器内的读取路径固定为
# /run/secrets/bmc_master_key、/run/secrets/bmc_tls_cert、/run/secrets/bmc_tls_key。
BMC_MASTER_KEY_FILE=./secrets/master.key
BMC_TLS_CERT_FILE=./secrets/server.crt
BMC_TLS_KEY_FILE=./secrets/server.key
BMC_TLS_MODE=auto
BMC_SERVER_BIND=0.0.0.0
BMC_SERVER_PORT=443
BMC_GRPC_BIND=0.0.0.0
BMC_GRPC_PORT=9090
# 仅本地开发用：1 允许缺少 TLS 证书启动（生产保持 0）。legacy 模板已透传该变量。
BMC_DEV_INSECURE=0
