# Agent 部署配置（配合 deploy/docker-compose.agent.yml 使用）
# 复制为 deploy/.env.agent 后填写配置。

# Server gRPC 地址：推荐使用带 scheme 的 URL（如 https://backup.example.com:9090 或 http://host:9090）
BMC_SERVER_GRPC_URL=https://backup.example.com:9090

# 首次从 Server Web UI 获取的一次性注册令牌（注册完成后建议清空并重建容器）
BMC_ENROLLMENT_TOKEN=<one-time-token>

# 宿主机源目录与恢复目录挂载路径（源目录以只读挂载，恢复目录以读写挂载）
BMC_SOURCE_ETC=/etc
BMC_SOURCE_SRV=/srv
BMC_RESTORE_ROOT=/var/lib/bmc-restore

# 可选覆盖：
# BMC_AGENT_IMAGE=wdjoys/backup-management-center-agent:latest
# VERSION=0.1.0
