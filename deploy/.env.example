# Server 环境变量示例
# 使用方式：cp deploy/.env.example deploy/.env，然后逐项审核并修改。
# 本文件只包含示例值，禁止填写真实凭据后提交 Git。

# Server 对外访问的完整 URL；必须与浏览器和 Agent 使用的域名一致。
BMC_PUBLIC_URL=https://backup.example.com

# Server 镜像地址；生产可填写固定版本或 sha 标签，不建议使用 latest 做回滚。
BMC_SERVER_IMAGE=wdjoys/backup-management-center-server:latest

# 构建版本号；仅在本地构建时使用。
VERSION=0.1.0

# 主密钥文件（32 字节随机值）；必须妥善离线备份，绝不能提交。
# Compose 文件位于 deploy/，Secret 路径相对于 deploy/ 解析。
BMC_MASTER_KEY_FILE=./secrets/master.key

# TLS 证书链和私钥；TLS 模式下必须存在，私钥绝不能提交。
BMC_TLS_CERT_FILE=./secrets/server.crt
BMC_TLS_KEY_FILE=./secrets/server.key

# TLS 模式：auto（默认，Server 自行提供 TLS）；Caddy 共存时填写 none。
# Caddy 模式仍必须保留 BMC_PUBLIC_URL 和主密钥，并由 Caddy 负责公网证书。
BMC_TLS_MODE=auto

# Server HTTP/API 的宿主机绑定地址和端口。Caddy 模式建议 127.0.0.1:8080。
BMC_SERVER_BIND=0.0.0.0
BMC_SERVER_PORT=443

# Agent gRPC 的宿主机绑定地址和端口。直连模式通常为 0.0.0.0:9090。
BMC_GRPC_BIND=0.0.0.0
BMC_GRPC_PORT=9090

# 仅本地隔离测试可设为 1，以跳过部分 TLS 校验；生产环境必须保持 0。
BMC_DEV_INSECURE=0
